# GEMINI_API_KEY: Required for Gemini AI API calls (server-side chat API + tooling).
# Never expose this to the Vite frontend (do not use VITE_ prefix).
# AI Studio automatically injects this at runtime from user secrets when applicable.
GEMINI_API_KEY="API_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="APP_URL_here"

# TEMPORARILY DISABLED — Website AI chatbot n8n webhook (POST). Restore when re-enabling n8n:
# Website AI chatbot n8n webhook (POST).
# Local/dev default (if unset): https://thegrowbiz.app.n8n.cloud/webhook-test/gemini-chat
# Production default (if unset): https://thegrowbiz.app.n8n.cloud/webhook/gemini-chat
# VITE_N8N_CHAT_WEBHOOK_URL="https://thegrowbiz.app.n8n.cloud/webhook-test/gemini-chat"

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — used by /api/chat and scripts/ingest_knowledge.py
# Never prefix these with VITE_ (they must not be bundled into the browser).
# Configure the same values in Vercel Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------
# Qdrant Cloud cluster URL (https://....qdrant.io)
QDRANT_URL=
# Qdrant Cloud API key
QDRANT_API_KEY=
# Qdrant collection name (default: gemini_motors_knowledge)
QDRANT_COLLECTION=gemini_motors_knowledge
