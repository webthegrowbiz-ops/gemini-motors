# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="API_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="APP_URL_here"

# Website AI chatbot n8n webhook (POST).
# Local/dev default (if unset): https://thegrowbiz.app.n8n.cloud/webhook-test/gemini-chat
# Production default (if unset): https://thegrowbiz.app.n8n.cloud/webhook/gemini-chat
# VITE_N8N_CHAT_WEBHOOK_URL="https://thegrowbiz.app.n8n.cloud/webhook-test/gemini-chat"

# Qdrant Cloud (RAG knowledge ingestion — scripts/ingest_knowledge.py)
# Never commit real credentials. Copy to a local .env file.
QDRANT_URL=
QDRANT_API_KEY=
# Optional override (default: gemini_motors_knowledge)
# QDRANT_COLLECTION=gemini_motors_knowledge
