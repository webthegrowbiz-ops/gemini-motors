{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,

  "redirects": [
    {
      "source": "/lcv",
      "destination": "/lcvlandingpage/",
      "permanent": true
    },
    {
      "source": "/lcv/",
      "destination": "/lcvlandingpage/",
      "permanent": true
    },
    {
      "source": "/lcv/index.html",
      "destination": "/lcvlandingpage/",
      "permanent": true
    },
    {
      "source": "/lcv/:path*",
      "destination": "/lcvlandingpage/",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/lcvlandingpage",
      "destination": "/lcv/index.html"
    },
    {
      "source": "/lcvlandingpage/",
      "destination": "/lcv/index.html"
    },
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/thank-you/(.*)",
      "destination": "/thank-you.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}