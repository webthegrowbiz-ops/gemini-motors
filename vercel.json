{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/chat.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },

  "redirects": [
    {
      "source": "/commercial/mhcv/:slug",
      "destination": "/commercial/medium-heavy/:slug",
      "permanent": true
    },
    {
      "source": "/commercial/mhcv/:slug/",
      "destination": "/commercial/medium-heavy/:slug",
      "permanent": true
    },
    {
      "source": "/lcv",
      "destination": "/lcvlandingpage/",
      "permanent": true
    },
    {
      "source": "/lcv/",
      "destination": "/lcvlandingpage/",
      "permanent": true
    },
    {
      "source": "/lcv/index.html",
      "destination": "/lcvlandingpage/",
      "permanent": true
    },
    {
      "source": "/lcv/:path*",
      "destination": "/lcvlandingpage/",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/lcvlandingpage",
      "destination": "/lcv/index.html"
    },
    {
      "source": "/lcvlandingpage/",
      "destination": "/lcv/index.html"
    },
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/thank-you/(.*)",
      "destination": "/thank-you.html"
    },
    {
      "source": "/((?!api/|src/|@vite|@react-refresh|@fs|node_modules/).*)",
      "destination": "/index.html"
    }
  ]
}
